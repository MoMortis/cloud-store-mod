{
  "schemaVersion": 1,
  "id": "cloudstore",
  "version": "${version}",
  "name": "Cloud Store",
  "description": "View and operate a cloud-store inventory inside Minecraft.",
  "authors": ["PetraSM", "Damomo1"],
  "environment": "client",
  "icon": "assets/cloudstore/icon.png",
  "entrypoints": {
    "client": [
      "com.cloudstore.client.CloudStoreClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": ">=26.2",
    "java": ">=25",
    "fabric-api": "*",
    "litematica": ">=0.28.4"
  }
}
